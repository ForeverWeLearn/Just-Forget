{
  "svelte.enable-ts-plugin": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/$RECYCLE.BIN": true,
    "**/__pycache__": true,
    "**/System Volume Information": true,
    "*.ini": true,
    "*.lnk": true,
    "*.zip": true,
    "README.md": true,
    "bun.lock": true,
    "tsconfig.json": true,
    "package.json": true,
    "vite.config.js": true,
    "svelte.config.js": true,
    ".gitignore": true,
    "src-tauri/Cargo.lock": true,
    "src-tauri/.gitignore": true,
    "build": true,
    ".svelte-kit": true,
    "node_modules": true,
    ".vscode": true,
    "src-tauri/gen": true,
    "src-tauri/icons": true,
    "src-tauri/target": true
  },
  "hide-files.files": [
    "README.md",
    "bun.lock",
    "tsconfig.json",
    "package.json",
    "vite.config.js",
    "svelte.config.js",
    ".gitignore",
    "src-tauri/Cargo.lock",
    "src-tauri/.gitignore",
    "build",
    ".svelte-kit",
    "node_modules",
    ".vscode",
    "src-tauri/gen",
    "src-tauri/icons",
    "src-tauri/target"
  ]
}