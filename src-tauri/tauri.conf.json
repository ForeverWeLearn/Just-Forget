{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Just Forget",
  "version": "1.0.0",
  "identifier": "com.justforget.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Just Forget",
        "decorations": false,
        "center": true,
        "width": 800,
        "height": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Fowel",
    "copyright": "Copyright © 2025 Fowel",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
